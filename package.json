{
  "name": "trailsnap-pi-agent",
  "version": "0.2.0",
  "private": true,
  "description": "TrailSnap MCP bridge and agent skill for Pi",
  "keywords": [
    "pi-package",
    "trailsnap",
    "mcp",
    "photos"
  ],
  "license": "AGPL-3.0-only",
  "scripts": {
    "check:pi": "tsc --noEmit --module NodeNext --moduleResolution NodeNext --target ES2022 --types node --skipLibCheck --allowImportingTsExtensions integrations/pi/extensions/trailsnap-mcp.ts integrations/pi/tests/extension.test.ts",
    "test:pi": "tsx --test integrations/pi/tests/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@types/node": "24.3.0",
    "tsx": "4.20.5",
    "typebox": "1.3.7",
    "typescript": "5.9.2"
  },
  "pi": {
    "extensions": [
      "./integrations/pi/extensions/trailsnap-mcp.ts"
    ],
    "skills": [
      "./skills/trailsnap-agent"
    ]
  }
}
