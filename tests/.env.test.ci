# =============================================================================
# TrailSnap CI runner 测试环境变量（GitHub Actions 专用）。
# -----------------------------------------------------------------------------
# 复制自 tests/.env.test.example，覆盖 CI runner 视角下的差异：
#   - 端口对齐 docker compose 的 host 端暴露（e2e 栈端口 8800/3180/8801/5532）
#   - server-integration job 在 env: 块内覆盖（service container pg 55432 + uvicorn 58000）
#   - TS_TEST_ENV=ci 供测试代码按环境分支；run-tests.ps1 -Mode 默认走 docker
#   - TS_E2E_SUITE=p0 兜底档位（PR/push 由 tests.yml 决定跑 full；workflow_dispatch 可选）
#
# 加载顺序（与 run-tests.ps1 保持一致）：
#   - 服务端点：CI runner 视角，docker compose 暴露到 host 的端口
#   - pg      ：e2e docker compose 自带 pg 容器（5532）；server-integration 用 service container 55432
# =============================================================================

# ---- 运行档位 ----
TS_TEST_ENV=ci
TS_E2E_SUITE=p0
TS_TEST_SCOPE=all

# ---- 服务端点（CI runner 视角，对齐 e2e docker compose host 端口）----
TS_API_BASE_URL=http://localhost:8800
TS_WEB_BASE_URL=http://localhost:3180
TS_AI_API_URL=http://localhost:8801
TS_DB_URL=postgresql://trailsnap:trailsnap@localhost:5532/trailsnap

# ---- 测试库管理 ----
# CI 由 service container / compose 提供全新 PG 卷，所以不需要重置/保留策略
TS_TEST_RESET_DB=false
TS_TEST_KEEP_SERVICES=false

# ---- Docker 测试栈端口（仅 docker-compose.yml 消费）----
TS_DOCKER_PG_PORT=5532
TS_DOCKER_SERVER_PORT=8800
TS_DOCKER_AI_PORT=8801
TS_DOCKER_WEB_PORT=3180

# ---- 前端 e2e 认证 & 数据 ----
TS_TEST_USERNAME=e2e-admin
TS_TEST_PASSWORD=Passw0rd!123
TS_E2E_ENABLE_FIXTURE_SCAN=true
# 测试照片源（独立 git 仓库，本地跑前先 ./tests/scripts/sync-test-photos.sh）
TS_TEST_PHOTOS_REPO=https://github.com/LC044/trailsnap-test-photos.git
TS_PHOTO_HOST_DIR=../../tests/fixtures/e2e-photos/fixtures
TS_PHOTO_DIR=/testdata/photos

