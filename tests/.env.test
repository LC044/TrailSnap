# =============================================================================
# TrailSnap 测试统一环境变量（单一数据源）
# -----------------------------------------------------------------------------
# docker 服务 / 前端 e2e / 后端单元测试 / AI 微服务 —— 全部读这一份文件。
# 改这里，四处生效：
#   - docker compose : tests/docker/docker-compose.test.yml (经 --env-file 注入)
#   - 前端 e2e       : package/website/playwright/e2e-env.ts (读 process.env)
#   - 后端 pytest     : package/server/tests/conftest.py (加载本文件 + 映射 DB_URL/AI_API_URL)
#   - AI pytest       : package/ai/tests/conftest.py (加载本文件)
#
# 切换环境只需改下面 TS_TEST_ENV + 对应 URL/端口：
#   dev   : 本地手起服务  (server:8000 / web:5176 / ai:8001 / pg:5532)
#   docker: 本地 docker   (server:8800 / web:8082 / ai:8801 / pg:5532)
#   ci    : CI runner     (同 docker)
# =============================================================================

# ---- 运行档位（run-tests.ps1 的默认值也来自这里）----
TS_TEST_ENV=dev
TS_TEST_COVER=smoke
TS_TEST_SCOPE=all

# ---- 服务端点（宿主机视角，所有 host 侧消费者共用）----
TS_API_BASE_URL=http://localhost:8000
TS_WEB_BASE_URL=http://localhost:5176
TS_AI_API_URL=http://localhost:8001
TS_DB_URL=postgresql://trailsnap:trailsnap@localhost:5532/trailsnap

# ---- Docker 测试栈端口（仅 docker-compose.test.yml 消费）----
# 容器内部互联（postgres:5432 / ai:8001）由 compose 静态写死，不在此处
TS_DOCKER_PG_PORT=5532
TS_DOCKER_SERVER_PORT=8800
TS_DOCKER_AI_PORT=8801
TS_DOCKER_WEB_PORT=8082

# ---- 前端 e2e 认证 & 数据 ----
TS_E2E_SUITE=dev
TS_TEST_USERNAME=e2e-admin
TS_TEST_PASSWORD=Passw0rd!123
# 是否启用文件夹扫描前置。默认 false=仅执行测试，不主动添加目录/触发扫描/等待任务；
# 显式设为 true 时，先执行独立 scan 预扫描，再进入 Playwright 用例
TS_E2E_ENABLE_FIXTURE_SCAN=false
# 宿主机照片源目录（挂载进容器的 /testdata/photos，供导入链路测试）
# helper 会按约定读取 smoke/ 与 p0/ 子目录；相对路径以 tests/docker/ 为基准
TS_PHOTO_HOST_DIR=../../tests/fixtures/e2e-photos
TS_PHOTO_DIR=/testdata/photos
