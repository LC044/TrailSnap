# =============================================================================
# TrailSnap 测试统一环境变量（单一数据源）
# -----------------------------------------------------------------------------
# docker 服务 / 前端 e2e / 后端单元测试 / AI 微服务 —— 全部读这一份文件。
# 改这里，四处生效：
#   - docker compose : tests/docker/docker-compose.yml (经 --env-file 注入)
#   - 前端 e2e       : package/website/playwright/e2e-env.ts (读 process.env)
#   - 后端 pytest     : package/server/tests/conftest.py (加载本文件 + 映射 DB_URL/AI_API_URL)
#   - AI pytest       : package/ai/tests/conftest.py (加载本文件)
#
# 切换环境只需改下面 TS_TEST_ENV + 对应 URL/端口：
#   dev   : 本地手起服务  (server:8000 / web:5176 / ai:8001 / pg:5532)
#   docker: 本地 docker   (server:8800 / web:3180 / ai:8801 / pg:5532)
#   ci    : CI runner     (同 docker)
# =============================================================================

# ---- 运行档位（run-tests.ps1 的 -Mode/-Level 默认值也来自这里）----
TS_TEST_ENV=dev
TS_E2E_SUITE=dev
TS_TEST_SCOPE=all

# ---- 服务端点（宿主机视角，所有 host 侧消费者共用）----
TS_API_BASE_URL=http://localhost:8000
TS_WEB_BASE_URL=http://localhost:5176
TS_AI_API_URL=http://localhost:8001
# ⚠️  默认指向独立测试库 trailsnap_test，避免与本地真实数据（zhousk 等账号）冲突。
# 如果想直接复用 trailsnap 库跑测试，必须确保该库里没有任何 user 行（否则 setup 会
# 因 has_users=true 跳过注册，导致 e2e-admin 登录 401，整套测试大面积失败）。
TS_DB_URL=postgresql://trailsnap:trailsnap@localhost:5532/trailsnap_test

# ---- 启动前重置测试库 ----
# 开启后，在启动 server 之前先把 TS_DB_URL 指向的目标库 DROP 掉（连维护库 postgres
# 执行 DROP DATABASE ... WITH (FORCE)），随后由 start.py 重建空库 → 全新测试数据。
# 仅在 dev 模式且 server 端口空闲（本次会真正启动 server）时执行；若 server 已在运行
# 则跳过并告警，避免破坏运行中的服务。docker/ci 模式不适用（pg 由 compose 栈管理）。
# 取值：true / 1 / yes 视为开启，其余（含 false）为关闭。
TS_TEST_RESET_DB=true

# ---- 测试结束后是否保留服务 ----
# 开启后，测试结束不关闭本次启动的本地服务（server / ai / web），也不做端口兜底清扫，
# 方便用浏览器/接口查看测试完成后的现场状态。默认 false（测完即关）。
# 注意：开启时 -Cleanup 的数据库删除也会跳过（避免破坏运行中服务的数据）。
# 取值：true / 1 / yes 视为开启，其余（含 false）为关闭。
TS_TEST_KEEP_SERVICES=false

# ---- Docker 测试栈端口（仅 docker-compose.yml 消费）----
# 容器内部互联（postgres:5432 / ai:8001）由 compose 静态写死，不在此处
TS_DOCKER_PG_PORT=5532
TS_DOCKER_SERVER_PORT=8800
TS_DOCKER_AI_PORT=8801
TS_DOCKER_WEB_PORT=3180

# ---- 前端 e2e 认证 & 数据 ----
TS_TEST_USERNAME=e2e-admin
TS_TEST_PASSWORD=Passw0rd!123
# 是否启用文件夹扫描前置。默认 false=仅执行测试，不主动添加目录/触发扫描/等待任务；
# 显式设为 true 时，先执行独立 scan 预扫描，再进入 Playwright 用例
TS_E2E_ENABLE_FIXTURE_SCAN=true
# 宿主机照片源目录（挂载进容器的 /testdata/photos，供导入链路测试）
# helper 会按约定读取 smoke/ 与 p0/ 子目录；相对路径以 tests/docker/ 为基准
# 测试照片来自独立 git 仓库（默认 LC044/trailsnap-test-photos）。
# 本地首次跑 e2e 前先执行：./tests/scripts/sync-test-photos.sh（或 Windows 版 .ps1）
TS_TEST_PHOTOS_REPO=https://github.com/LC044/trailsnap-test-photos.git
TS_PHOTO_HOST_DIR=../../tests/fixtures/e2e-photos/fixtures # Docker挂载宿主路径，仅Docker模式使用
TS_PHOTO_DIR=/testdata/photos # ！必须，本机照片的绝对路径，用于照片扫描

